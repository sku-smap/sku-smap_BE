# ─────────────────────────────────────────
# Server
# ─────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# 프런트 주소(쉼표 구분). 줄을 빼면 localhost:3000, 5173 (빈 값으로 두면 전부 막힘)
# CORS_ALLOWED_ORIGINS=https://example.com

# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smap
DB_USER=smap
DB_PASSWORD=smap

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─────────────────────────────────────────
# AWS
# ─────────────────────────────────────────
AWS_REGION=ap-northeast-2

# ─────────────────────────────────────────
# OpenAI
# ─────────────────────────────────────────
OPENAI_API_KEY=

# ─────────────────────────────────────────
# ECR (운영 Compose 실행 시 사용)
# ─────────────────────────────────────────
# 예: 123456789012.dkr.ecr.ap-northeast-2.amazonaws.com
ECR_REGISTRY=
ECR_REPOSITORY=smap-api
IMAGE_TAG=latest
