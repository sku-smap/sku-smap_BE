# ─────────────────────────────────────────
# Server
# ─────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# 프런트 주소(쉼표 구분). 생략 시 localhost:3000, localhost:5173, 운영 프런트 허용
# CORS_ALLOWED_ORIGINS=https://sku-smap.vercel.app

# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smap
DB_USER=smap
DB_PASSWORD=smap

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
CAMPUS_CACHE_ENABLED=true
CAMPUS_CACHE_TTL_SECONDS=300

# ─────────────────────────────────────────
# AWS
# ─────────────────────────────────────────
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# 비공개 사진 버킷. URL 발급에는 로컬 AWS 프로필 또는 배포 IAM 역할이 필요하다.
S3_PHOTOS_ENABLED=true
S3_PHOTOS_BUCKET=smap-photos-450974103987-ap-northeast-2-an
S3_PHOTOS_PREFIX=
S3_PHOTOS_URL_TTL_SECONDS=3600

# ─────────────────────────────────────────
# OpenAI
# ─────────────────────────────────────────
OPENAI_API_KEY=
# 관리 API(POST /api/v1/admin/embedding-jobs)의 X-Admin-Key 값. 비우면 관리 API 막힘
ADMIN_API_KEY=

# ─────────────────────────────────────────
# STT (Oracle faster-whisper). 토큰은 Oracle 서버 .env의 STT_TOKEN과 같은 값
# ─────────────────────────────────────────
STT_BASE_URL=https://stt.eunhasu03.cloud
STT_TOKEN=

# ─────────────────────────────────────────
# ECR (운영 Compose 실행 시 사용)
# ─────────────────────────────────────────
# 예: 123456789012.dkr.ecr.ap-northeast-2.amazonaws.com
ECR_REGISTRY=
ECR_REPOSITORY=smap-api
IMAGE_TAG=latest
